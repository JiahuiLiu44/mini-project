library(tidyverse)
q1 <- read_csv("q1.csv")
q2 <- read_csv("q2.csv")
q3 <- read_csv("q3.csv")
q4 <- read_csv("q4.csv")
q5 <- read_csv("q5.csv")
q6a <- read_csv("q6a.csv")
q6b <- read_csv("q6b.csv")
q7 <- read_csv("q7.csv")
library(tidyverse)
q1 <- read_csv("q1.csv")
q2 <- read_csv("q2.csv")
q3 <- read_csv("q3.csv")
q4 <- read_csv("q4.csv")
q5 <- read_csv("q5.csv")
q6a <- read_csv("q6a.csv")
q6b <- read_csv("q6b.csv")
q7 <- read_csv("q7.csv")
library(tidyverse)
q1 <- read_csv("q1.csv")
q2 <- read_csv("q2.csv")
q3 <- read_csv("q3.csv")
q4 <- read_csv("q4.csv")
q5 <- read_csv("q5.csv")
q6a <- read_csv("q6a.csv")
q6b <- read_csv("q6b.csv")
q7 <- read_csv("q7.csv")
library(tidyverse)
q1  <- read_csv("q1.csv",  show_col_types = FALSE)
q2  <- read_csv("q2.csv",  show_col_types = FALSE)
q3  <- read_csv("q3.csv",  show_col_types = FALSE)
q4  <- read_csv("q4.csv",  show_col_types = FALSE)
q5  <- read_csv("q5.csv",  show_col_types = FALSE)
q6a <- read_csv("q6a.csv", show_col_types = FALSE)
q6b <- read_csv("q6b.csv", show_col_types = FALSE)
q7  <- read_csv("q7.csv",  show_col_types = FALSE)
q1 %>%
ggplot(aes(x = reorder(Airline, Max_Departure_Delay),
y = Max_Departure_Delay)) +
geom_col() +
coord_flip() +
labs(
title = "Maximum Departure Delay by Airline",
x = "Airline",
y = "Max departure delay (minutes)"
)
q2 %>%
ggplot(aes(x = reorder(Airline, Max_Early_Departure_Minutes),
y = Max_Early_Departure_Minutes)) +
geom_col(fill = "darkgreen") +
coord_flip() +
labs(
title = "Maximum Early Departure by Airline",
x = "Airline",
y = "Early departure (minutes)"
)
q3 %>%
ggplot(aes(x = reorder(Weekday, Num_Flights),
y = Num_Flights)) +
geom_col(fill = "orange") +
coord_flip() +
labs(
title = "Total Flights by Weekday",
x = "Day of the Week",
y = "Number of Flights"
)
q4
q5
q5 %>%
ggplot(aes(x = reorder(Airline_Name, Avg_Departure_Delay),
y = Avg_Departure_Delay)) +
geom_col(fill = "red") +
coord_flip() +
labs(
title = "Airport with Highest Avg Departure Delay for Each Airline",
x = "Airline",
y = "Average delay (minutes)"
)
q6a
q6b %>%
ggplot(aes(x = reorder(Airport_Name, Num_Cancellations),
y = Num_Cancellations,
fill = Most_Frequent_Reason)) +
geom_col() +
coord_flip() +
labs(
title = "Most Frequent Cancellation Reason per Airport",
x = "Airport",
y = "Number of cancellations",
fill = "Reason"
)
q6b_top15 <- q6b %>%
arrange(desc(Num_Cancellations)) %>%
slice(1:15)
q6b_top15 %>%
ggplot(aes(x = reorder(Airport_Name, Num_Cancellations),
y = Num_Cancellations,
fill = Most_Frequent_Reason)) +
geom_col() +
coord_flip() +
labs(
title = "Top 15 Airports by Cancellation Count",
x = "Airport",
y = "Number of cancellations",
fill = "Reason"
) +
theme_bw(base_size = 14)
q6b_top15 <- q6b %>%
arrange(desc(Num_Cancellations)) %>%
slice(1:15)
q6b_top15 %>%
ggplot(aes(x = Num_Cancellations,
y = reorder(Airport_Name, Num_Cancellations),
fill = Most_Frequent_Reason)) +
geom_col() +
labs(
title = "Top 15 Airports by Cancellations",
x = "Number of cancellations",
y = "Airport",
fill = "Reason"
) +
scale_x_continuous(breaks = scales::pretty_breaks(5)) +
theme_bw(base_size = 12) +
theme(
plot.title      = element_text(hjust = 0.5, size = 14),
axis.text.y     = element_text(size = 8),
legend.position = "bottom"
)
q7 <- q7 %>%
mutate(FlightDate = as.Date(FlightDate))
q7 %>%
ggplot(aes(x = FlightDate)) +
geom_line(aes(y = Num_Flights), size = 0.4) +
geom_line(aes(y = Avg_Flights_Preceding_3_Days), size = 0.7) +
labs(
title = "Daily Flights and 3-Day Moving Average",
x = "Date",
y = "Number of flights"
) +
theme_bw(base_size = 12) +
theme(
plot.title = element_text(hjust = 0.5),
axis.text.x = element_text(angle = 45, hjust = 1)
)
library(tidyverse)
q7 <- read_csv("q7.csv") %>%
mutate(
# 转换为真正的数字，处理 "NULL"
Num_Flights = as.numeric(Num_Flights),
Avg_Flights_Preceding_3_Days = as.numeric(Avg_Flights_Preceding_3_Days),
FlightDate = as.Date(FlightDate)
)
# 检查是否有 NA
print(summary(q7))
# 画图
q7 %>%
ggplot(aes(x = FlightDate)) +
geom_line(aes(y = Num_Flights), linewidth = 0.4, color = "gray40") +
geom_line(aes(y = Avg_Flights_Preceding_3_Days), linewidth = 0.8, color = "steelblue") +
labs(
title = "Daily Flights with 3-Day Moving Average",
x = "Date",
y = "Number of flights"
) +
theme_bw(base_size = 12) +
theme(
plot.title = element_text(hjust = 0.5),
axis.text.x = element_text(angle = 45, hjust = 1)
)
